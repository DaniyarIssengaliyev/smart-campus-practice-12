ber(t.slice(3, 5));\n  const answer = (available, code, message) => storeValue('roomDecision', {available, code, message}, false);\n  if (!/^([01]\\d|2[0-3]):[0-5]\\d$/.test(startText)) return answer(false, 'INVALID', 'Validation error — enter a start time in HH:MM format.');\n  if (!Number.isInteger(duration) || duration < 1 || duration > 120) return answer(false, 'INVALID', 'Validation error — duration must be 1 to 120 minutes.');\n  const start = toMinutes(startText), end = start + duration;\n  if (start <= 510) return answer(false, 'INVALID', 'Validation error — start time must be after 08:30.');\n  if (end > 1440) return answer(false, 'INVALID', 'Validation error — the interval must end by midnight.');\n  if (RoomStatus.isSwitchedOn) return answer(false, 'BLOCKED', 'Unavailable — Room 101 is blocked.');\n  for (const slot of [MorningBooking.text, NoonBooking.text]) {\n    if (start < toMinutes(slot.slice(6,11)) && end > toMinutes(slot.slice(0,5))) return answer(false, 'OVERLAP', 'Unavailable — overlaps the ' + slot.slice(0,11) + ' booking.');\n  }\n  return answer(true, 'FREE', 'Available — Room 101 is free for this interval.');\n})() }}","buttonColor":"#176B63","topRow":47.0,"bottomRow":53.0,"parentRowSpace":10.0,"type":"BUTTON_WIDGET","mobileRightColumn":31.0,"parentColumnSpace":15.0,"dynamicTriggerPathList":[{"key":"onClick"}],"leftColumn":5.0,"dynamicBindingPathList":[],"text":"Check Availability","isDisabled":false,"key":"97577a2e78","rightColumn":31.0,"dynamicHeight":"FIXED","widgetId":"b79dcfe74e","minWidth":100.0,"isVisible":true,"version":1.0,"parentId":"0","renderMode":"CANVAS","mobileTopRow":47.0,"originalTopRow":47.0,"mobileLeftColumn":5.0,"borderRadius":"6px","originalBottomRow":53.0,"buttonVariant":"PRIMARY"},{"needsErrorInfo":false,"mobileBottomRow":63.0,"widgetName":"Result","topRow":55.0,"bottomRow":63.0,"parentRowSpace":10.0,"type":"TEXT_WIDGET","mobileRightColumn":59.0,"animateLoading":true,"overflow":"NONE","fontFamily":"{{appsmith.theme.fon